src-tauri/target/

# User data — personal / sensitive, never commit
candidate_base.yaml
search_variants.yaml
strategy.md
disparo.json
notif.json
modo_autonomo.json
# Fictional test fixtures (no real data) used by the claudia-teste-sandbox skill
!.claude/skills/claudia-teste-sandbox/fixtures/candidate_base.yaml
!.claude/skills/claudia-teste-sandbox/fixtures/search_variants.yaml
!.claude/skills/claudia-teste-sandbox/fixtures/strategy.md

# SQLite runtime databases
*.db
*.db-journal
*.db-wal
*.db-shm

# Claude workspace and session data
workspace/
.claude/*
# ...menos os skills, que são convenções do projeto e devem ser versionados.
# Git não permite re-incluir dentro de um diretório excluído, daí `.claude/*`
# em vez de `.claude/` — settings.local.json e dados de sessão continuam fora.
!.claude/skills/

# Signing keys — never commit
*.key
*.key.pub

# Windows
Thumbs.db
desktop.ini

# Windows Sandbox lab (sandbox-lab/): tools, the MCP key, guest output, evidence and generated files never go to git.
# sandbox-lab/.gitignore repeats these on purpose (two layers).
sandbox-lab/shared/tools/
sandbox-lab/shared/secrets/
sandbox-lab/shared/out/
sandbox-lab/evidence/
sandbox-lab/sandbox/sandbox.generated.wsb
sandbox-lab/sandbox/guest.config.json
sandbox-lab/.mcp.json
# Sandbox work folder (deploy + guest-rw). Always the one in the main checkout.
.sandbox-work/
