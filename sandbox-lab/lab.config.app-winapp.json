{
  "$comment": "Perfil: rodar um app desktop controlado pelo winapp. Rede ligada (o winapp precisa dela); bloqueie a internet com sandbox\\app\\guest-firewall.ps1 (wsb exec -r System) antes de abrir o app. Requer LAB_APP_PROJECT e LAB_WORK_DIR. Antes: scripts\\app-stage.ps1. Uso: scripts\\test-up.ps1 -Config lab.config.app-winapp.json",
  "projectPath": "%LAB_APP_PROJECT%",
  "extensionsDir": "shared/extensions",
  "extensions": [
    "lab-ext"
  ],
  "dbBackup": "shared/db/backup.sqlite",
  "dbHashFile": "shared/db/backup.sha256",
  "dbVerifySql": "shared/db/verify.sql",
  "dbVerifyExpected": "shared/db/verify.expected.txt",
  "chrome": {
    "exe": "shared/tools/chrome/chrome-win64/chrome.exe",
    "startUrl": "http://localhost:8080/test-page.html",
    "testServerPort": 8080,
    "remoteDebuggingPort": 9222
  },
  "mcp": {
    "$comment": "Detalhes do Windows-MCP ficam em shared/mcp.json; port deve bater com ele.",
    "port": 8000,
    "configFile": "shared/mcp.json",
    "authKeyFile": "shared/secrets/mcp-auth.key",
    "authKeyEnv": "LAB_MCP_AUTH_KEY"
  },
  "vGPU": "Enable",
  "clipboardRedirection": "Enable",
  "bootTimeoutSec": 300,
  "memoryMB": 6144,
  "networking": "Enable",
  "extraMappedFolders": [
    {
      "host": "%LAB_WORK_DIR%\\deploy",
      "readOnly": true,
      "sandbox": "C:\\appdeploy"
    },
    {
      "host": "%LAB_WORK_DIR%\\guest-rw",
      "readOnly": false,
      "sandbox": "C:\\labwork"
    }
  ]
}